{
  "name": "claude",
  "worker_command": ["claude", "-p"],
  "model_flag": "--model",
  "skill_dirs": [".claude/skills", "~/.claude/skills"],
  "user_skill_dir": "~/.claude/skills",
  "hooks": {
    "method": "settings-json",
    "file": ".claude/settings.local.json",
    "snippets": ["hooks/settings-snippet.json"]
  },
  "usage_probe": "drover usage check",
  "product": "claude-code",
  "agent": {
    "roles": ["preflight", "classify"],
    "output_flags": ["--output-format", "json"],
    "result_key": "result",
    "mode": "dontAsk",
    "tools": ["Read", "Grep", "Glob", "LS"],
    "commands": ["drover preflight", "drover github-read", "gh issue view", "gh issue list", "gh pr view",
                 "gh pr list", "gh pr diff", "git log", "git show", "git diff", "jq", "cat", "head", "tail",
                 "grep", "ls", "wc", "echo", "printf"],
    "deny": ["Edit", "Write", "MultiEdit", "NotebookEdit", "Bash(gh issue edit:*)", "Bash(gh issue comment:*)",
             "Bash(gh pr edit:*)", "Bash(gh pr comment:*)", "Bash(gh pr merge:*)", "Bash(gh api:*)",
             "Bash(gh project:*)", "Bash(git push:*)", "Bash(git commit:*)"]
  },
  "version_command": ["claude", "--version"],
  "permissions": {
    "mode_flag": "--permission-mode",
    "mode": "acceptEdits",
    "allow_flag": "--allowedTools",
    "deny_flag": "--disallowedTools",
    "read_only_dirs": ["{drover_home}"],
    "read_only_deny": ["Edit"],
    "tools": ["Read", "Edit", "MultiEdit", "Write", "Glob", "Grep", "LS", "NotebookEdit",
              "TodoWrite", "Task", "Skill", "WebFetch", "WebSearch"],
    "commands": ["drover", "gh", "git", "jq", "python3", "python", "node", "npm", "npx", "pnpm", "yarn", "bun",
                 "bash", "sh", "cd", "pwd", "ls", "cat", "head", "tail", "wc", "sort", "uniq", "cut", "tr",
                 "grep", "rg", "sed", "awk", "find", "diff", "echo", "printf", "test", "[", "true", "false",
                 "mkdir", "mktemp", "touch", "cp", "mv", "rm", "ln", "chmod", "date", "sleep", "env",
                 "basename", "dirname", "realpath", "tee", "xargs", "which", "command", "curl", "openssl"],
    "deny": ["Bash(gh pr merge:*)"]
  }
}
