{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "drover project config (.drover/config.json)",
  "description": "One config per repo, at .drover/config.json (tracked). Validated by `drover config validate` at the start of every drover command (FR-CFG-2). Keys and changes: specs/config.md.",
  "type": "object",
  "required": [
    "project"
  ],
  "additionalProperties": false,
  "definitions": {
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(:[A-Za-z0-9][A-Za-z0-9._-]*)?$"
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "$ref": "#/definitions/skills",
          "description": "Skills every worker of this role uses (FR-CFG-3)."
        },
        "model": {
          "type": "string",
          "description": "Model for this role; overrides model_tier (FR-CFG-6)."
        },
        "harness": {
          "type": "string",
          "description": "Harness for this role; a name under harnesses/ (FR-CFG-6)."
        },
        "template": {
          "type": "string",
          "description": "hc template for this role (FR-CFG-6)."
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Parallel workers for this role. Default 1."
        }
      }
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "properties": {
    "version": {
      "type": "integer"
    },
    "description": {
      "type": "string",
      "description": "Short scannable label, e.g. 'admin build pipeline'."
    },
    "project": {
      "type": "object",
      "required": [
        "owner",
        "number"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "description": "`gh project` takes the number, not the title."
        },
        "title": {
          "type": "string"
        }
      }
    },
    "harness": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Worker harness: a file harnesses/<name>.json in the drover install folder. Default \"claude\". Renamed from upstream `host`."
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "description": "Branch every issue branch is cut from and squash-merged into. Default \"main\"."
    },
    "verify_commands": {
      "$ref": "#/definitions/string_list",
      "description": "Project-owned commands the merge gate runs on base + branch. At least one non-blank command is needed before dispatch (exit 9)."
    },
    "commit_style": {
      "enum": [
        "conventional",
        "bracket-tag",
        "plain",
        "other"
      ],
      "description": "Detected at onboard from the last 50 base-branch subjects (writing-standard.md section 1)."
    },
    "model_tier": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Default model ladder by card complexity."
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build": {
          "$ref": "#/definitions/role"
        },
        "qa": {
          "$ref": "#/definitions/role"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": {
              "$ref": "#/definitions/skills"
            },
            "model": {
              "type": "string"
            },
            "harness": {
              "type": "string"
            },
            "template": {
              "type": "string"
            },
            "max_workers": {
              "type": "integer",
              "minimum": 1
            },
            "second_opinion": {
              "enum": [
                "off",
                "risky",
                "always"
              ],
              "description": "roles.md FR-REV-9."
            },
            "second_opinion_model": {
              "type": "string",
              "description": "Must differ from the reviewer's model (FR-REV-10)."
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "description": "Skill routing per card label: labels.<label>.<role> = [skills] (FR-CFG-3). Card paths by label stay fixed.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "build": {
            "$ref": "#/definitions/skills"
          },
          "qa": {
            "$ref": "#/definitions/skills"
          },
          "review": {
            "$ref": "#/definitions/skills"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "description": "Where QA evidence goes (FR-EVD-1): an orphan branch, or the PR branch under a path.",
      "properties": {
        "mode": {
          "enum": [
            "branch",
            "pr"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "description": "mode branch: the orphan branch. Default drover-evidence."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "mode pr: folder on the PR branch."
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit_email": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_commands": {
          "type": "array",
          "description": "Extra command words a headless worker may run, merged into the harness allow list as Bash(<word>:*) (config.md FR-HRN-4), e.g. a wrapper a global hook rewrites commands to.",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        }
      }
    },
    "hc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "view": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "repo",
            "repo+url"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "repo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timezone": {
      "type": "string",
      "description": "IANA zone for times drover writes. Absent: the machine's zone."
    },
    "columns": {
      "$ref": "#/definitions/string_list",
      "description": "The seven Status options: Backlog, Ready, Building, QA, Review, Blocked, Done."
    },
    "paths": {
      "type": "object",
      "properties": {
        "project_md": {
          "type": [
            "string",
            "null"
          ]
        },
        "pre_flight_md": {
          "type": "string"
        }
      }
    },
    "human_approves_merge": {
      "type": "boolean",
      "description": "Legacy switch; prefer merge_policy.default \"human\"."
    },
    "merge_policy": {
      "type": "object",
      "properties": {
        "default": {
          "enum": [
            "auto",
            "human"
          ]
        },
        "auto_max_lines": {
          "type": "integer",
          "minimum": 0
        },
        "size_exclude": {
          "$ref": "#/definitions/string_list"
        },
        "always_human": {
          "type": "object"
        },
        "allow_auto_on_production": {
          "type": "boolean"
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "globs": {
          "$ref": "#/definitions/string_list"
        },
        "allowed_envs": {
          "type": "array",
          "items": {
            "enum": [
              "test",
              "staging",
              "live"
            ]
          }
        },
        "target_env": {
          "enum": [
            "test",
            "staging",
            "live"
          ]
        },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "human_steps": {
          "$ref": "#/definitions/string_list"
        }
      }
    },
    "no_progress_cycles": {
      "type": "integer",
      "minimum": 0,
      "description": "Halt after this many rounds with no card reaching Done. Default 6."
    },
    "max_dispatches": {
      "type": "integer",
      "minimum": 0,
      "description": "Hard ceiling on worker dispatches per run; 0 = none."
    },
    "rebuild_cap": {
      "type": "integer",
      "minimum": 0
    },
    "block_rate_alert_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "usage_pause_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "tick_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Runner round interval. Default 120."
    },
    "runtime_verification": {
      "type": "object"
    },
    "refine": {
      "type": "object",
      "description": "Settings for the standalone /ui-refine-loop skill (skills/ui-refine-loop/references/config.md)."
    },
    "collect": {
      "type": "object",
      "description": "drover-collect sources (skills/drover-collect/SKILL.md). IDs and hosts only; secrets stay in .env."
    },
    "notifications": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "chat_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "bot_identity": {
          "type": "string",
          "description": "Assignee used as the claim mutex."
        }
      }
    },
    "_qa_all": {
      "type": "boolean",
      "description": "Left by an upgrade from a qa-only board; `drover setup board-migrate` applies and removes it."
    }
  }
}
